# À recopier dans Vercel > Settings > Environment Variables (jamais dans la conversation ni sur GitHub)
# Supabase > Project Settings > API : « Project URL »
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Supabase > Project Settings > API Keys : clé « publishable » (sb_publishable_...) ou ancienne clé « anon »
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Supabase > bouton « Connect » > « Transaction pooler » (port 6543), avec ton mot de passe de base
DATABASE_URL=postgresql://postgres.xxxxxxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
# Adresse publique du site (pour les liens des e-mails)
NEXT_PUBLIC_SITE_URL=https://www.stayndiscover.com
# Facultatif pour l'instant : clé Google Maps (Maps JavaScript), limitée à ton domaine
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
